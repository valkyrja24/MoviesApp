<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MoviesApp.ViewModels"
             xmlns:models="clr-namespace:MoviesApp.Models"
             x:Class="MoviesApp.Pages.MovieDetailsPage"
             x:DataType="vm:MovieDetailsViewModel"
             Title="{Binding Title}">

    <Grid>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

        <Label Text="{Binding StatusMessage}"
               IsVisible="{Binding HasStatusMessage}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="Gray"
               Margin="24" />

        <ScrollView IsVisible="{Binding HasMovie}">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Image Source="{Binding Movie.Poster}"
                       IsVisible="{Binding Movie.HasPoster}"
                       Aspect="AspectFit"
                       HeightRequest="320" />

                <Label Text="{Binding Movie.Title}"
                       FontSize="24"
                       FontAttributes="Bold" />

                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding Movie.Year}" TextColor="Gray" />
                    <Label Text="{Binding Movie.Runtime}" TextColor="Gray" />
                    <Label Text="{Binding Movie.Genre}" TextColor="Gray" />
                </HorizontalStackLayout>

                <Label Text="Ratings" FontAttributes="Bold" FontSize="18" />
                <CollectionView ItemsSource="{Binding Movie.Ratings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Rating">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                <Label Grid.Column="0" Text="{Binding Source}" />
                                <Label Grid.Column="1" Text="{Binding Value}" FontAttributes="Bold" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Plot" FontAttributes="Bold" FontSize="18" />
                <Label Text="{Binding Movie.Plot}" />

                <Label Text="Director" FontAttributes="Bold" />
                <Label Text="{Binding Movie.Director}" />

                <Label Text="Actors" FontAttributes="Bold" />
                <Label Text="{Binding Movie.Actors}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
